# Copy to ~/.config/playlist-fs/backup.env, edit, and chmod 600 before enabling a timer.
# Initialize the dedicated repository explicitly first. Values below are placeholders.
MUSIC_CATALOG_RESTIC_REPOSITORY=sftp:backup-user@backup-host:/srv/backups/personal-music
MUSIC_CATALOG_RESTIC_LABEL=jaguar
# systemd EnvironmentFile does not expand $HOME or ~. Use your absolute private path.
RESTIC_PASSWORD_FILE=/absolute/private/path/repository-password
